default_platform(:android)

ROOT = File.expand_path("..", __dir__)
AAB_PATH = File.join(ROOT, "build/app/outputs/bundle/release/app-release.aab")

platform :android do
  desc "Build the release App Bundle and upload it to the Play Store"
  lane :deploy do |options|
    Dir.chdir(ROOT) do
      sh("flutter", "build", "appbundle", "--release")
    end

    upload_to_play_store(
      track: options[:track] || "production",
      release_status: options[:validate_only] ? "draft" : (options[:release_status] || "completed"),
      aab: AAB_PATH,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: options[:validate_only] || false
    )
  end
end

# iOS is deployed directly by deploy.sh (not through a fastlane lane): it needs no
# credentials beyond the Xcode-signed-in Apple ID, and `flutter build ipa` has a known
# harmless failure mode after a successful upload that's easier to handle in bash than
# by parsing fastlane's `sh` exception output.
