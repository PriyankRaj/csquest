default_platform(:android)

ROOT = File.expand_path("..", __dir__)
AAB_PATH = File.join(ROOT, "build/app/outputs/bundle/release/app-release.aab")

platform :android do
  desc "Build the release App Bundle and upload it to the Play Store"
  lane :deploy do |options|
    Dir.chdir(ROOT) do
      sh("flutter", "build", "appbundle", "--release")
    end

    upload_to_play_store(
      track: options[:track] || "production",
      release_status: options[:validate_only] ? "draft" : (options[:release_status] || "completed"),
      aab: AAB_PATH,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: options[:validate_only] || false
    )
  end
end

platform :ios do
  desc "Build the release IPA and upload it to App Store Connect"
  lane :deploy do
    Dir.chdir(ROOT) do
      sh(
        "flutter", "build", "ipa",
        "--export-options-plist=ios/ExportOptions/ExportOptions.plist"
      )
    end
  end
end
